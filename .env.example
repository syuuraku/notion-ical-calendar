# Required
NOTION_API_KEY=secret_xxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret token to protect the calendar feed URL.
# Generate with: openssl rand -hex 32
# When set, the feed is served at /calendar/<TOKEN>.ics
# When unset, the feed is public at /calendar.ics (not recommended in production)
CALENDAR_TOKEN=

# Optional second subscription at /wechat/<token>.ics
# Set WECHAT_DATABASE_ID to enable it. By default both subscriptions use CALENDAR_TOKEN.
# WECHAT_DATABASE_ID=
# WECHAT_PROPERTY_DATE=Duration
# WECHAT_PROPERTY_TITLE=Title
# Optional token override for this subscription only
# WECHAT_CALENDAR_TOKEN=

# Optional — defaults shown
PORT=3000
CACHE_TTL=300

# Notion property name overrides (only needed if your DB uses different names)
# NOTION_PROPERTY_TITLE=Name
# NOTION_PROPERTY_DATE=Date
# NOTION_PROPERTY_DESCRIPTION=
# NOTION_PROPERTY_LOCATION=
